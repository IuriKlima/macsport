rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /{allPaths=**} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    match /curriculos/{fileName} {
      allow read: if isAdmin();
      // O upload deve ser feito pela API server-side
      allow write: if isAdmin();
    }
  }
}
